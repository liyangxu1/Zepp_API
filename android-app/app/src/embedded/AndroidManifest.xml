<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <activity
            android:name="com.litianyi.napcatassistant.NapCatWebUiActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <service
            android:name="com.litianyi.napcatassistant.TermuxResultService"
            android:exported="false" />

        <provider
            android:name="com.litianyi.napcatassistant.UpdateFileProvider"
            android:authorities="${applicationId}.mutual_like_updates"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name="com.litianyi.napcatassistant.MainActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
    </application>

</manifest>
